    "keycloak_realm_settings_bootstrapped": "/var/lib/catena/keycloak-realm-settings-bootstrapped",
    "version_stamp": "/etc/catena/version.txt",
    "admin_ssh": "/etc/catena/admin-ssh",
    "traefik": "/etc/catena/traefik",
    "traefik_dynamic": "/etc/catena/traefik/dynamic",
    "admin_actions": "/etc/catena/admin-actions.yml",
    "admin_actions_d": "/etc/catena/admin-actions.d",
    "admin_allowed": "/etc/catena/admin-allowed.yaml",
    "public_ports_summary": "/etc/catena/public-ports.summary.json",
    "public_ports_d": "/etc/catena/public-ports.d",
    "extra_tiles": "/etc/catena/extra-tiles.yml",
    "default_apps": "/etc/catena/default-apps.json",
    "backup_retention_env": "/etc/catena/backup-retention.env",
    "backup_sqlite": "/etc/catena/backup-sqlite",
    "backup_paths": "/etc/catena/backup-paths",
    "backup_exclude_patterns": "/etc/catena/backup-exclude-patterns",
    "backup_coverage_paths": "/etc/catena/backup-coverage.paths",
    "restic_pass": "/etc/catena/restic.pass",
    "payload_image": "/etc/catena/.payload-image",
