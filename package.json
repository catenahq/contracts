{
  "name": "@catenahq/contracts",
  "version": "0.3.0",
  "private": false,
  "description": "Shared contracts for the catena repos: brand tokens + wordmark assets, pricing tier metadata, legal MSA pin + canonical text. Consumers pin a tag and bump deliberately.",
  "type": "module",
  "exports": {
    "./brand": "./brand/src/index.js",
    "./brand/tokens/*": "./brand/tokens/*",
    "./brand/wordmark/*": "./brand/wordmark/*",
    "./brand/assets/*": "./brand/assets/*",
    "./pricing/tiers.json": "./pricing/tiers.json",
    "./legal/msa.json": "./legal/msa.json",
    "./legal/master-agreement.md": "./legal/master-agreement.md"
  },
  "files": [
    "brand",
    "pricing",
    "legal"
  ],
  "scripts": {
    "test": "node brand/test.js && node scripts/validate-json.mjs",
    "check:unicode": "node scripts/check-unicode.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catenahq/contracts.git"
  },
