{
  "reserved_capabilities": {
    "beszel": { "provider": "beszel", "readers": [] },
    "beszelgate": { "provider": "beszel", "readers": [] }
  },
  "alert_intake_sources": { "resources": "beszel" },
  "apps": {
    "beszel": {
      "stack": "catena-beszel",
      "services": {
        "app": {
          "networks": {
            "catena-beszel": ["beszel-hub"],
            "catena-beszelgate": ["beszel-hub"],
            "catena-alerts": []
          },
          "ports": [{ "published": 18190, "target": 8090 }]
        },
        "agent": { "host_network": true, "docker_socket": true },
        "relay": {}
      },
      "volumes": {
        "beszel-hub-data": "catena-beszel_beszel-hub-data",
        "agent-key": "catena-beszel_agent-key",
        "agent-data": "catena-beszel_agent-data",
        "relay-state": "catena-beszel_relay-state"
      },
      "sqlite": [
        { "volume": "beszel-hub-data", "file": "data.db" },
        { "volume": "beszel-hub-data", "file": "auxiliary.db" }
      ],
      "env_core_writes": [
        "APP_URL",
        "USER_CREATION",
        "TRUSTED_AUTH_HEADER",
        "TRUSTED_PROXY_IPS",
        "HUB_OIDC_ISSUER"
      ],
      "env_declared": [
        "SUBDOMAIN",
        "HUB_URL",
        "ADMIN_EMAIL",
        "HUB_PASSWORD",
        "TOKEN",
        "STATE_KEY",
        "ALERT_URL",
        "ALERT_TOKEN",
        "HUB_OIDC_SECRET",
        "SMTP_PASSWORD",
        "SMTP_RELAY_HOST",
        "SMTP_RELAY_PORT",
        "SMTP_RELAY_USER",
        "SMTP_RELAY_TLS",
        "SMTP_RELAY_SENDER",
        "UPDATE_LEVEL"
      ],
      "secrets": ["alert_intake_token_resources", "beszel_oidc_client_secret", "smtp_password"],
      "provides": { "beszel": ["url"], "beszelgate": ["url"] },
      "reads": []
    }
  }
}
